# GBNF grammar for bn, generated by prototype/make_grammar.py.
# Do not edit by hand: regenerate from phrasebook.json so the two
# cannot drift apart. A grammar that permits a sentence the phrasebook
# cannot render would let the decoder produce an unmatchable transcript.

root ::= " "? phrase "."?

phrase ::=
    slot-loc " এ সাহায্য পাঠান"
  | slot-n " জন নিখোঁজ"
  | "আগুন ছড়াচ্ছে"
  | "আবহাওয়া খারাপ"
  | "আমরা " slot-loc " এ আছি"
  | "আমরা " slot-n " জন"
  | "আমরা অপেক্ষা করছি"
  | "আমরা আটকে পড়েছি"
  | "আমরা নিরাপদ আছি"
  | "আমরা পথে আছি"
  | "আমাদের অ্যাম্বুলেন্স দরকার"
  | "আমাদের আশ্রয় দরকার"
  | "আমাদের এখনই উদ্ধার দরকার"
  | "আমাদের ওষুধ দরকার"
  | "আমাদের কম্বল দরকার"
  | "আমাদের খাবার দরকার"
  | "আমাদের জল দরকার"
  | "আমাদের ডাক্তার দরকার"
  | "আমাদের দড়ি দরকার"
  | "আমাদের নৌকা দরকার"
  | "আমাদের সরিয়ে নিতে হবে"
  | "উত্তর দিন"
  | "এখানে " slot-n " জন আটকে আছে"
  | "এখানে " slot-n " জন আহত"
  | "এখানে " slot-n " জন শিশু আছে"
  | "এখানে আগুন লেগেছে"
  | "এখানে চিকিৎসা জরুরি অবস্থা"
  | "এখানে দুর্ঘটনা ঘটেছে"
  | "এখানে বন্যা হয়েছে"
  | "এখানে ভূমিকম্প হয়েছে"
  | "এখানে ভূমিধস হয়েছে"
  | "গ্যাস লিক হচ্ছে"
  | "জল বাড়ছে"
  | "ঝড় আসছে"
  | "নেটওয়ার্ক নেই"
  | "বাড়ি ধসে পড়েছে"
  | "বার্তা পুনরাবৃত্তি করুন"
  | "বার্তা পেয়েছি"
  | "বিদ্যুৎ নেই"
  | "রাস্তা বন্ধ"
  | "শেষ"
  | "সেতু ভেঙে গেছে"

slot-loc ::= "মুজাফফরপুর" | "গুয়াহাটি" | "দারভাঙ্গা" | "দেরাদুন" | "গোরখপুর" | "বারাণসী" | "শ্রীনগর" | "চেন্নাই" | "জোশীমঠ" | "সুরাট" | "নাসিক" | "পাটনা" | "কোচি" | "পুরী" | "কটক" | "ভুজ"
slot-n ::= digits | "পঞ্চাশ" | "চল্লিশ" | "পনেরো" | "এগারো" | "ত্রিশ" | "চৌদ্দ" | "সতেরো" | "আঠারো" | "উনিশ" | "একশো" | "বারো" | "পাঁচ" | "তেরো" | "ষোলো" | "নয়" | "সাত" | "তিন" | "দুই" | "ছয়" | "বিশ" | "চার" | "আট" | "এক" | "দশ"

digits ::= [0-9]+

