root ::= " "? phrase "."?

phrase ::=
    slot-loc " க்கு உதவி அனுப்புங்கள்"
  | slot-n " பேர் காணவில்லை"
  | "இங்கே " slot-n " குழந்தைகள் உள்ளனர்"
  | "இங்கே " slot-n " பேர் காயமடைந்துள்ளனர்"
  | "இங்கே " slot-n " பேர் சிக்கியுள்ளனர்"
  | "இங்கே தீ பிடித்துள்ளது"
  | "இங்கே நிலச்சரிவு ஏற்பட்டது"
  | "இங்கே நிலநடுக்கம் ஏற்பட்டது"
  | "இங்கே மருத்துவ அவசரநிலை"
  | "இங்கே விபத்து நடந்தது"
  | "இங்கே வெள்ளம் வந்துள்ளது"
  | "எங்களுக்கு ஆம்புலன்ஸ் வேண்டும்"
  | "எங்களுக்கு உடனடி மீட்பு வேண்டும்"
  | "எங்களுக்கு உணவு வேண்டும்"
  | "எங்களுக்கு கயிறு வேண்டும்"
  | "எங்களுக்கு தங்குமிடம் வேண்டும்"
  | "எங்களுக்கு தண்ணீர் வேண்டும்"
  | "எங்களுக்கு படகு வேண்டும்"
  | "எங்களுக்கு போர்வை வேண்டும்"
  | "எங்களுக்கு மருத்துவர் வேண்டும்"
  | "எங்களுக்கு மருந்து வேண்டும்"
  | "எங்களை வெளியேற்ற வேண்டும்"
  | "எரிவாயு கசிகிறது"
  | "கட்டிடம் இடிந்து விழுந்தது"
  | "சாலை மூடப்பட்டுள்ளது"
  | "செய்தி கிடைத்தது"
  | "செய்தியை மீண்டும் சொல்லுங்கள்"
  | "தீ பரவுகிறது"
  | "நாங்கள் " slot-loc " இல் இருக்கிறோம்"
  | "நாங்கள் " slot-n " பேர்"
  | "நாங்கள் காத்திருக்கிறோம்"
  | "நாங்கள் சிக்கிக்கொண்டோம்"
  | "நாங்கள் பாதுகாப்பாக இருக்கிறோம்"
  | "நாங்கள் வழியில் இருக்கிறோம்"
  | "நீர்மட்டம் உயர்கிறது"
  | "நெட்வொர்க் இல்லை"
  | "பதில் சொல்லுங்கள்"
  | "பாலம் உடைந்துவிட்டது"
  | "புயல் வருகிறது"
  | "மின்சாரம் இல்லை"
  | "முடிந்தது"
  | "வானிலை மோசமாக உள்ளது"

slot-loc ::= "முசாபர்பூர்" | "கவுகாத்தி" | "கோரக்பூர்" | "டேராடூன்" | "தர்பங்கா" | "ஸ்ரீநகர்" | "ஜோஷிமட்" | "கட்டாக்" | "வாரணாசி" | "நாசிக்" | "பாட்னா" | "சென்னை" | "கொச்சி" | "சூரத்" | "புஜ்" | "பூரி"
slot-n ::= digits | "பன்னிரண்டு" | "பத்தொன்பது" | "பதினொன்று" | "பதிமூன்று" | "பதினைந்து" | "பதினான்கு" | "பதினெட்டு" | "நாற்பது" | "பதினாறு" | "பதினேழு" | "முப்பது" | "ஐம்பது" | "இருபது" | "மூன்று" | "ஒன்பது" | "நான்கு" | "இரண்டு" | "எட்டு" | "ஐந்து" | "பத்து" | "ஒன்று" | "நூறு" | "ஆறு" | "ஏழு"

