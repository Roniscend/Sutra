root ::= " "? phrase "."?

phrase ::=
    slot-loc " मध्ये मदत पाठवा"
  | slot-n " लोक बेपत्ता आहेत"
  | "आग पसरत आहे"
  | "आम्हाला अन्न हवे"
  | "आम्हाला औषध हवे"
  | "आम्हाला डॉक्टर हवा"
  | "आम्हाला तातडीने मदत हवी"
  | "आम्हाला दोरी हवी"
  | "आम्हाला निवारा हवा"
  | "आम्हाला पाणी हवे"
  | "आम्हाला बाहेर काढावे लागेल"
  | "आम्हाला ब्लँकेट हवे"
  | "आम्हाला रुग्णवाहिका हवी"
  | "आम्हाला होडी हवी"
  | "आम्ही " slot-loc " मध्ये आहोत"
  | "आम्ही " slot-n " लोक आहोत"
  | "आम्ही अडकलो आहोत"
  | "आम्ही वाट पाहत आहोत"
  | "आम्ही वाटेत आहोत"
  | "आम्ही सुरक्षित आहोत"
  | "इथे " slot-n " मुले आहेत"
  | "इथे " slot-n " लोक अडकले आहेत"
  | "इथे " slot-n " लोक जखमी आहेत"
  | "इथे अपघात झाला आहे"
  | "इथे आग लागली आहे"
  | "इथे दरड कोसळली आहे"
  | "इथे पूर आला आहे"
  | "इथे भूकंप झाला आहे"
  | "इथे वैद्यकीय आणीबाणी आहे"
  | "इमारत कोसळली आहे"
  | "उत्तर द्या"
  | "गॅस गळती होत आहे"
  | "नेटवर्क नाही"
  | "पाणी वाढत आहे"
  | "पूल तुटला आहे"
  | "रस्ता बंद आहे"
  | "वादळ येत आहे"
  | "वीज नाही"
  | "संदेश पुन्हा सांगा"
  | "संदेश मिळाला"
  | "समाप्त"
  | "हवामान खराब आहे"

slot-loc ::= "मुझफ्फरपूर" | "डेहराडून" | "गुवाहाटी" | "गोरखपूर" | "श्रीनगर" | "वाराणसी" | "चेन्नई" | "जोशीमठ" | "दरभंगा" | "पाटणा" | "नाशिक" | "सुरत" | "पुरी" | "कोची" | "भुज" | "कटक"
slot-n ::= digits | "एकोणीस" | "पन्नास" | "पंधरा" | "चाळीस" | "बारा" | "अकरा" | "शंभर" | "सतरा" | "तेरा" | "चौदा" | "सोळा" | "अठरा" | "वीस" | "चार" | "पाच" | "दोन" | "सात" | "तीस" | "सहा" | "तीन" | "दहा" | "एक" | "आठ" | "नऊ"

digits ::= [0-9]+
