# GBNF grammar for en, generated by prototype/make_grammar.py.
# Do not edit by hand: regenerate from phrasebook.json so the two
# cannot drift apart. A grammar that permits a sentence the phrasebook
# cannot render would let the decoder produce an unmatchable transcript.

root ::= " "? phrase "."?

phrase ::=
    "A building has collapsed"
  | "A storm is approaching"
  | "Message received"
  | "Over and out"
  | "Please respond"
  | "Repeat the message"
  | "Send help to " slot-loc
  | "The bridge has collapsed"
  | "The fire is spreading"
  | "The road is blocked"
  | "The water is rising"
  | "The weather is bad"
  | "There are " slot-n " children here"
  | "There are " slot-n " of us"
  | "There has been a landslide here"
  | "There has been an accident here"
  | "There has been an earthquake here"
  | "There is a fire here"
  | "There is a flood here"
  | "There is a gas leak"
  | "There is a medical emergency here"
  | "There is no network"
  | "There is no power"
  | "We are at " slot-loc
  | "We are cut off"
  | "We are on the way"
  | "We are safe"
  | "We are waiting"
  | "We need a boat"
  | "We need a doctor"
  | "We need an ambulance"
  | "We need blankets"
  | "We need food"
  | "We need immediate rescue"
  | "We need medicine"
  | "We need rope"
  | "We need shelter"
  | "We need to be evacuated"
  | "We need water"
  | "building on fire"
  | "fire here"
  | "flooding here"
  | "help us"
  | "need drinking water"
  | "rescue us"
  | "the area is flooded"
  | slot-n " people are injured here"
  | slot-n " people are missing"
  | slot-n " people are trapped here"

slot-loc ::= "Muzaffarpur" | "Gorakhpur" | "Darbhanga" | "Joshimath" | "Guwahati" | "Dehradun" | "Varanasi" | "Srinagar" | "Chennai" | "Cuttack" | "Nashik" | "Kochi" | "Surat" | "Patna" | "Puri" | "Bhuj"
slot-n ::= digits | "seventeen" | "thirteen" | "fourteen" | "eighteen" | "nineteen" | "sixteen" | "hundred" | "fifteen" | "twelve" | "thirty" | "twenty" | "eleven" | "seven" | "forty" | "eight" | "fifty" | "three" | "nine" | "four" | "five" | "six" | "one" | "ten" | "two"

digits ::= [0-9]+

