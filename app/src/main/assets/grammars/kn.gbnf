# GBNF grammar for kn, generated by prototype/make_grammar.py.
# Do not edit by hand: regenerate from phrasebook.json so the two
# cannot drift apart. A grammar that permits a sentence the phrasebook
# cannot render would let the decoder produce an unmatchable transcript.

root ::= " "? phrase "."?

phrase ::=
    slot-loc " ಗೆ ಸಹಾಯ ಕಳುಹಿಸಿ"
  | slot-n " ಜನ ನಾಪತ್ತೆಯಾಗಿದ್ದಾರೆ"
