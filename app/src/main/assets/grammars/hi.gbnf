slot-n ::= digits | "उन्नीस" | "पंद्रह" | "ग्यारह" | "सत्रह" | "चालीस" | "अठारह" | "पाँच" | "पचास" | "सोलह" | "पांच" | "तेरह" | "बारह" | "चौदह" | "चार" | "सात" | "तीस" | "तीन" | "बीस" | "एक" | "नौ" | "दस" | "दो" | "छः" | "सौ" | "आठ" | "छह"

digits ::= [0-9]+
