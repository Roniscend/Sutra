root ::= " "? phrase "."?

phrase ::=
    slot-loc " માં મદદ મોકલો"
  | slot-n " લોકો ગુમ છે"
  | "અમને આશરો જોઈએ"
  | "અમને એમ્બ્યુલન્સ જોઈએ"
  | "અમને ખોરાક જોઈએ"
  | "અમને ડૉક્ટર જોઈએ"
  | "અમને તાત્કાલિક બચાવ જોઈએ"
  | "અમને દવા જોઈએ"
  | "અમને દોરડું જોઈએ"
  | "અમને ધાબળા જોઈએ"
  | "અમને પાણી જોઈએ"
  | "અમને બહાર કાઢવા પડશે"
  | "અમને હોડી જોઈએ"
  | "અમે " slot-loc " માં છીએ"
  | "અમે " slot-n " લોકો છીએ"
  | "અમે ફસાઈ ગયા છીએ"
  | "અમે રસ્તામાં છીએ"
  | "અમે રાહ જોઈ રહ્યા છીએ"
  | "અમે સુરક્ષિત છીએ"
  | "અહીં " slot-n " બાળકો છે"
  | "અહીં " slot-n " લોકો ઘાયલ છે"
  | "અહીં " slot-n " લોકો ફસાયા છે"
  | "અહીં અકસ્માત થયો છે"
  | "અહીં આગ લાગી છે"
  | "અહીં તબીબી કટોકટી છે"
  | "અહીં ધરતીકંપ આવ્યો છે"
  | "અહીં પૂર આવ્યું છે"
  | "અહીં ભૂસ્ખલન થયું છે"
  | "આગ ફેલાઈ રહી છે"
  | "ગેસ લીક થઈ રહ્યો છે"
  | "જવાબ આપો"
  | "નેટવર્ક નથી"
  | "પાણી વધી રહ્યું છે"
  | "પુલ તૂટી ગયો છે"
  | "મકાન ધરાશાયી થયું છે"
  | "રસ્તો બંધ છે"
  | "વાવાઝોડું આવી રહ્યું છે"
  | "વીજળી નથી"
  | "સંદેશ ફરી કહો"
  | "સંદેશ મળ્યો"
  | "સમાપ્ત"
  | "હવામાન ખરાબ છે"

slot-loc ::= "મુઝફ્ફરપુર" | "ગુવાહાટી" | "દેહરાદૂન" | "ચેન્નાઈ" | "વારાણસી" | "શ્રીનગર" | "ગોરખપુર" | "દરભંગા" | "જોશીમઠ" | "નાસિક" | "પુરી" | "પટના" | "સુરત" | "કોચી" | "કટક" | "ભુજ"
slot-n ::= digits | "અગિયાર" | "સત્તર" | "ચાળીસ" | "ત્રીસ" | "ઓગણીસ" | "પાંચ" | "અઢાર" | "પંદર" | "ત્રણ" | "પચાસ" | "વીસ" | "ચૌદ" | "બાર" | "સાત" | "ચાર" | "સોળ" | "તેર" | "આઠ" | "દસ" | "એક" | "નવ" | "સો" | "બે" | "છ"

digits ::= [0-9]+
