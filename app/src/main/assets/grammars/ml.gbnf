root ::= " "? phrase "."?

phrase ::=
    slot-loc " ലേക്ക് സഹായം അയക്കൂ"
  | slot-n " പേരെ കാണാനില്ല"
  | "അവസാനിച്ചു"
  | "ഇവിടെ " slot-n " കുട്ടികളുണ്ട്"
  | "ഇവിടെ " slot-n " പേർ കുടുങ്ങിയിരിക്കുന്നു"
  | "ഇവിടെ " slot-n " പേർക്ക് പരിക്കേറ്റു"
  | "ഇവിടെ അപകടം ഉണ്ടായി"
  | "ഇവിടെ ഉരുൾപൊട്ടൽ ഉണ്ടായി"
  | "ഇവിടെ തീപിടിത്തം ഉണ്ടായി"
  | "ഇവിടെ ഭൂകമ്പം ഉണ്ടായി"
  | "ഇവിടെ മെഡിക്കൽ അടിയന്തരാവസ്ഥയാണ്"
  | "ഇവിടെ വെള്ളപ്പൊക്കം ഉണ്ടായി"
  | "കാലാവസ്ഥ മോശമാണ്"
  | "കെട്ടിടം തകർന്നു"
  | "കൊടുങ്കാറ്റ് വരുന്നു"
  | "ഗ്യാസ് ചോർച്ചയുണ്ട്"
  | "ഞങ്ങളെ ഒഴിപ്പിക്കണം"
  | "ഞങ്ങൾ " slot-loc " ൽ ആണ്"
  | "ഞങ്ങൾ " slot-n " പേരാണ്"
  | "ഞങ്ങൾ കാത്തിരിക്കുന്നു"
  | "ഞങ്ങൾ കുടുങ്ങിപ്പോയി"
  | "ഞങ്ങൾ വഴിയിലാണ്"
  | "ഞങ്ങൾ സുരക്ഷിതരാണ്"
  | "ഞങ്ങൾക്ക് അഭയം വേണം"
  | "ഞങ്ങൾക്ക് ആംബുലൻസ് വേണം"
  | "ഞങ്ങൾക്ക് ഉടൻ രക്ഷ വേണം"
  | "ഞങ്ങൾക്ക് കയർ വേണം"
  | "ഞങ്ങൾക്ക് ഡോക്ടറെ വേണം"
  | "ഞങ്ങൾക്ക് പുതപ്പ് വേണം"
  | "ഞങ്ങൾക്ക് ഭക്ഷണം വേണം"
  | "ഞങ്ങൾക്ക് മരുന്ന് വേണം"
  | "ഞങ്ങൾക്ക് വള്ളം വേണം"
  | "ഞങ്ങൾക്ക് വെള്ളം വേണം"
  | "തീ പടരുന്നു"
  | "നെറ്റ്‌വർക്ക് ഇല്ല"
  | "പാലം തകർന്നു"
  | "മറുപടി പറയൂ"
  | "റോഡ് അടഞ്ഞിരിക്കുന്നു"
  | "വെള്ളം ഉയരുന്നു"
  | "വൈദ്യുതി ഇല്ല"
  | "സന്ദേശം ആവർത്തിക്കുക"
  | "സന്ദേശം ലഭിച്ചു"

slot-loc ::= "മുസാഫർപൂർ" | "ഗുവാഹത്തി" | "കട്ടക്ക്" | "ഗോരഖ്പൂർ" | "ഡെറാഡൂൺ" | "ജോഷിമഠ്" | "ശ്രീനഗർ" | "വാരാണസി" | "സൂറത്ത്" | "കൊച്ചി" | "നാസിക്" | "ചെന്നൈ" | "ദർഭംഗ" | "പട്ന" | "പുരി" | "ഭുജ്"
slot-n ::= digits | "പന്ത്രണ്ട്" | "പത്തൊൻപത്" | "പതിനെട്ട്" | "പതിമൂന്ന്" | "പതിനൊന്ന്" | "പതിനഞ്ച്" | "മുപ്പത്" | "പതിനാല്" | "പതിനാറ്" | "പതിനേഴ്" | "നാൽപത്" | "മൂന്ന്" | "ഇരുപത്" | "അൻപത്" | "രണ്ട്" | "ഒൻപത്" | "അഞ്ച്" | "പത്ത്" | "എട്ട്" | "ഒന്ന്" | "നാല്" | "നൂറ്" | "ആറ്" | "ഏഴ്"

digits ::= [0-9]+
